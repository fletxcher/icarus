#!/usr/bin/env bash
# Runs a command with Icarus's Python environment (build123d) first on the PATH, when the
# machine has one in $ICARUS_HOME/venv. XFOIL and everything else it finds on the PATH as usual.
#
# Usage: icarus-exec <command> [args...]
#
# Installed in $ICARUS_HOME/bin.
set -euo pipefail

home="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -d "$home/venv/bin" ]] && export PATH="$home/venv/bin:$PATH"
exec "$@"
