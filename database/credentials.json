{
  "collection": "credentials",
  "description": "Each user's own model API keys and work station. The secrets are encrypted with CREDENTIALS_KEY; `details` holds what can be shown without decrypting.",
  "enforced": true,
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
        "_id",
        "user_id",
        "kind",
        "name",
        "sealed",
        "details",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "user_id": {
          "bsonType": "string"
        },
        "kind": {
          "bsonType": "string",
          "enum": [
            "model_key",
            "workstation"
          ]
        },
        "name": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sealed": {
          "bsonType": "string",
          "minLength": 1
        },
        "details": {
          "bsonType": "object"
        },
        "created_at": {
          "bsonType": "date"
        },
        "updated_at": {
          "bsonType": "date"
        }
      }
    }
  },
  "indexes": [
    {
      "name": "user_credential_unique",
      "unique": true,
      "key": {
        "user_id": 1,
        "kind": 1,
        "name": 1
      }
    }
  ]
}
