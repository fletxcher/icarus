{
  "collection": "simulations",
  "description": "CFD jobs submitted to the simulation work station, with their status and results.",
  "enforced": false,
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
        "_id",
        "thread_id",
        "case",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "user_id": {
          "bsonType": "string"
        },
        "thread_id": {
          "bsonType": [
            "string",
            "null"
          ]
        },
        "hidden": {
          "bsonType": "bool"
        },
        "notified_at": {
          "bsonType": [
            "date",
            "null"
          ]
        },
        "case": {
          "anyOf": [
            {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "reynolds",
                "mach",
                "mesh"
              ],
              "properties": {
                "kind": {
                  "bsonType": "string",
                  "enum": [
                    "cfd"
                  ]
                },
                "shape": {
                  "bsonType": "string",
                  "enum": [
                    "airfoil",
                    "cylinder",
                    "ellipse",
                    "wedge",
                    "rectangle"
                  ]
                },
                "naca": {
                  "bsonType": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4,5}$"
                },
                "aspect_ratio": {
                  "bsonType": [
                    "number",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 20
                },
                "half_angle": {
                  "bsonType": [
                    "number",
                    "null"
                  ],
                  "minimum": 5,
                  "maximum": 60
                },
                "alpha": {
                  "bsonType": "number",
                  "minimum": -30,
                  "maximum": 30
                },
                "reynolds": {
                  "bsonType": "number",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "mach": {
                  "bsonType": "number",
                  "minimum": 0,
                  "maximum": 5,
                  "exclusiveMaximum": true
                },
                "mesh": {
                  "bsonType": "string",
                  "enum": [
                    "coarse",
                    "medium",
                    "fine"
                  ]
                },
                "wall_type": {
                  "bsonType": "string",
                  "enum": [
                    "no_slip",
                    "slip",
                    "moving",
                    "rotating"
                  ]
                },
                "wall_velocity_x": {
                  "bsonType": "number"
                },
                "wall_velocity_y": {
                  "bsonType": "number"
                },
                "spin_ratio": {
                  "bsonType": "number",
                  "minimum": -10,
                  "maximum": 10
                },
                "roughness_height": {
                  "bsonType": "number",
                  "minimum": 0,
                  "maximum": 0.05
                },
                "regime": {
                  "bsonType": "string",
                  "enum": [
                    "auto",
                    "steady",
                    "transient"
                  ]
                },
                "video": {
                  "bsonType": "bool"
                }
              }
            },
            {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "geometry_file_id",
                "support_axis",
                "support_side"
              ],
              "properties": {
                "kind": {
                  "bsonType": "string",
                  "enum": [
                    "fea"
                  ]
                },
                "geometry_file_id": {
                  "bsonType": "string"
                },
                "geometry_name": {
                  "bsonType": [
                    "string",
                    "null"
                  ]
                },
                "units": {
                  "bsonType": "string",
                  "enum": [
                    "mm",
                    "m",
                    "in"
                  ]
                },
                "material": {
                  "bsonType": "string",
                  "enum": [
                    "inconel718",
                    "ti6al4v",
                    "aluminium7075",
                    "steel4340"
                  ]
                },
                "mesh": {
                  "bsonType": "string",
                  "enum": [
                    "coarse",
                    "medium",
                    "fine"
                  ]
                },
                "support_axis": {
                  "bsonType": "string",
                  "enum": [
                    "x",
                    "y",
                    "z"
                  ]
                },
                "support_side": {
                  "bsonType": "string",
                  "enum": [
                    "min",
                    "max"
                  ]
                },
                "spin_rpm": {
                  "bsonType": "number",
                  "minimum": 0,
                  "maximum": 200000
                },
                "spin_axis_origin": {
                  "bsonType": "array",
                  "items": {
                    "bsonType": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "spin_axis_direction": {
                  "bsonType": "array",
                  "items": {
                    "bsonType": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "pressure_mpa": {
                  "bsonType": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "gas_temperature_c": {
                  "bsonType": [
                    "number",
                    "null"
                  ],
                  "minimum": -50,
                  "maximum": 1500
                },
                "htc_w_m2k": {
                  "bsonType": "number",
                  "minimum": 0,
                  "exclusiveMinimum": true,
                  "maximum": 50000
                },
                "base_temperature_c": {
                  "bsonType": "number",
                  "minimum": -50,
                  "maximum": 1500
                },
                "modal": {
                  "bsonType": "bool"
                }
              }
            }
          ]
        },
        "status": {
          "bsonType": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ]
        },
        "result": {
          "bsonType": [
            "object",
            "null"
          ]
        },
        "error": {
          "bsonType": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "bsonType": "date"
        },
        "updated_at": {
          "bsonType": "date"
        }
      }
    }
  },
  "indexes": [
    {
      "name": "thread_id_1_created_at_-1",
      "key": {
        "thread_id": 1,
        "created_at": -1
      }
    },
    {
      "name": "user_simulations",
      "key": {
        "user_id": 1,
        "created_at": -1
      }
    }
  ]
}
