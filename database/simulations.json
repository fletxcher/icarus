{
  "collection": "simulations",
  "description": "CFD jobs submitted to the simulation work station, with their status and results.",
  "enforced": false,
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
        "_id",
        "thread_id",
        "case",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "user_id": {
          "bsonType": "string"
        },
        "thread_id": {
          "bsonType": [
            "string",
            "null"
          ]
        },
        "hidden": {
          "bsonType": "bool"
        },
        "case": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "reynolds",
            "mach",
            "mesh"
          ],
          "properties": {
            "shape": {
              "bsonType": "string",
              "enum": [
                "airfoil",
                "cylinder",
                "ellipse",
                "wedge",
                "rectangle"
              ]
            },
            "naca": {
              "bsonType": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4,5}$"
            },
            "aspect_ratio": {
              "bsonType": [
                "number",
                "null"
              ],
              "minimum": 1,
              "maximum": 20
            },
            "half_angle": {
              "bsonType": [
                "number",
                "null"
              ],
              "minimum": 5,
              "maximum": 60
            },
            "alpha": {
              "bsonType": "number",
              "minimum": -30,
              "maximum": 30
            },
            "reynolds": {
              "bsonType": "number",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "mach": {
              "bsonType": "number",
              "minimum": 0,
              "maximum": 5,
              "exclusiveMaximum": true
            },
            "mesh": {
              "bsonType": "string",
              "enum": [
                "coarse",
                "medium",
                "fine"
              ]
            },
            "wall_type": {
              "bsonType": "string",
              "enum": [
                "no_slip",
                "slip",
                "moving",
                "rotating"
              ]
            },
            "wall_velocity_x": {
              "bsonType": "number"
            },
            "wall_velocity_y": {
              "bsonType": "number"
            },
            "spin_ratio": {
              "bsonType": "number",
              "minimum": -10,
              "maximum": 10
            },
            "roughness_height": {
              "bsonType": "number",
              "minimum": 0,
              "maximum": 0.05
            },
            "regime": {
              "bsonType": "string",
              "enum": [
                "auto",
                "steady",
                "transient"
              ]
            },
            "video": {
              "bsonType": "bool"
            }
          }
        },
        "status": {
          "bsonType": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ]
        },
        "result": {
          "bsonType": [
            "object",
            "null"
          ]
        },
        "error": {
          "bsonType": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "bsonType": "date"
        },
        "updated_at": {
          "bsonType": "date"
        }
      }
    }
  },
  "indexes": [
    {
      "name": "thread_id_1_created_at_-1",
      "key": {
        "thread_id": 1,
        "created_at": -1
      }
    },
    {
      "name": "user_simulations",
      "key": {
        "user_id": 1,
        "created_at": -1
      }
    }
  ]
}
